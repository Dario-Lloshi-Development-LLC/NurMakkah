# Bazel Configuration File for NurMakkah
# This file contains Bazel build configurations for optimal performance

# Common build flags
common --enable_platform_specific_config

# Performance optimizations
common --jobs=8
common --local_cpu_resources=8
common --local_ram_resources=4096

# Caching and remote execution
common --disk_cache=~/.bazel/disk_cache
common --repository_cache=~/.bazel/repository_cache

# Build output
common --verbose_failures
common --show_timestamps

# Android configuration
build --android_sdk_repository=@androidsdk
build --android_ndk_repository=@androidndk

# iOS configuration (if applicable)
build --apple_platform_type=ios

# Kotlin configuration
build --extra_toolchains=@io_bazel_rules_kotlin//kotlin:kotlin_toolchain

# Node.js configuration (for React Native)
build --extra_toolchains=@nodejs//:toolchain

# Test configuration
test --test_output=short
test --test_summary=short

# Release build configuration
build:release --compilation_mode=opt
build:release --strip=always

# Debug build configuration
build:debug --compilation_mode=dbg
build:debug --copt=-g

# Android-specific configurations
build:android --platforms=@io_bazel_rules_android//android:android_x86
build:android --android_sdk_version=34
build:android --android_ndk_version=25.1.8937393

# iOS-specific configurations (future use)
build:ios --platforms=@build_bazel_rules_apple//apple:ios_x86_64

